            #     lamb= 1.0
            # )
            iic_loss = IID_losses.IID_loss(cfg.class_num,output, target_output,1,0,1.0)
        optimizer.zero_grad()
        iic_loss.backward()
        optimizer.step()
    return output

def test_time_adapt_eval(input, model, optimizer, optim_state, cfg, target_output,current_aux):
    optimizer.load_state_dict(optim_state)
    test_time_tuning(model, input, optimizer, cfg, target_output,current_aux)
