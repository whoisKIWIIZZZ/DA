def integrate_feature(base_feature,cfg):
   
    N,D = base_feature.shape
    device1 = base_feature.device
    if cfg.class_num_hidden == 0:
        return torch.empty(0,D,device=device1)
    
    M=cfg.class_num_hidden
    if cfg.strategy == "mix":
        feature = base_feature.clone()
        shuffled_indices = torch.randperm(N, device=device1)
        shuffled_feature = base_feature[shuffled_indices]
        hidden_feature = cfg.alpha*base_feature + (1-cfg.alpha)*shuffled_feature
        return hidden_feature[:,]

    elif cfg.strategy == "noise":
        noise = torch.randn((N,D),device=base_feature.device)
        base_feature += noise
        return base_feature
    elif cfg.strategy == "PCA":
        from sklearn.decomposition import PCA
        X = base_feature.cpu().numpy()
        pca = PCA(n_components=5)
        pca.fit(X)

        mean_vec = pca.mean_
        principal_axes = pca.components_
        hidden_features = []
        for i in range(principal_axes.shape[0]):
            f_pos = mean_vec + cfg.alpha * principal_axes[i]
            f_neg = mean_vec - cfg.alpha * principal_axes[i]
            hidden_features.append(f_pos)
            hidden_features.append(f_neg)

        hidden_features = torch.tensor(hidden_features, dtype=torch.float32, device=device)
       # hidden_features = hidden_features / hidden_features.norm(dim=-1, keepdim=True)

        return hidden_features

    elif cfg.strategy == "1":
        hidden_features = []
        # Normalize base features for stable projection calculation
        base_features_norm = base_feature.detach() / (torch.norm(base_feature.detach(), dim=1, keepdim=True)+1e-8)
        
        attempts = 0
        while len(hidden_features) < M and attempts < M*11:
            # 1. Generate a random vector
            h = torch.randn(D, device=device)
            h_ortho = h.clone()

            # 2. Subtract the projection onto each of the base vectors
            for i in range(N):
                b = base_features_norm[i]
                proj = torch.dot(h_ortho, b) * b
                h_ortho = h_ortho - proj
            
            # 3. If the resulting vector is not a zero vector, normalize and add it
            if torch.norm(h_ortho) > 1e-6:
                h_ortho = h_ortho / torch.norm(h_ortho)
                hidden_features.append(h_ortho)
            
            attempts += 1
            
        if len(hidden_features) < M:
            logger.warning(f"Could only generate {len(hidden_features)}/{M} orthogonal features.")

        
        return torch.stack(hidden_features) if hidden_features else torch.empty(0, D, device=device)
    else:
        raise ValueError(f"Unknown strategy: {cfg.strategy},choose from :PCA,noise ,mix")




