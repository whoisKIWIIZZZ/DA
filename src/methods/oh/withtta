def ways_of_create_prompts(prompt_prefix,name,type:int):
    if type == 1:
        return prompt_prefix + " " + name + "."
    elif type == 2:
        return prompt_prefix + "not"+ name + "."
    elif type == 3:
        return  "a close up photo of " + name + "."
    else:
        raise ValueError("Wrong type;Choose from 1,2,3")



def clip_pre_text(cfg):
    #M = cfg.class_num_hidden
    List_rd = []
    with open(cfg.name_file) as f:
        for line in f:
            List_rd.extend([i for i in line.split()])
    f.close()
    classnames = List_rd
    classnames = [name.replace("_", " ") for name in classnames]
    cfg.classname = classnames
    prompt_prefix = cfg.DIFF_ALIGN.CTX_INIT.replace("_", " ")
    prompts = [ways_of_create_prompts(prompt_prefix,name,1)for name in classnames]
    tokenized_prompts = torch.cat([clip.tokenize(p) for p in prompts]).cuda()  # 把text变为数字信息
    #print(classnames)
   # breakpoint()
    return tokenized_prompts


def clip_text(model, text_features, inputs_test):
    with torch.no_grad():
        image_features = model.encode_image(inputs_test)
    logit_scale = model.logit_scale.data

    #idk which is wrong
    #logit_scale = logit_scale.exp().cpu()
    logit_scale = logit_scale.exp()



    image_features = image_features / (image_features.norm(dim=1, keepdim=True) + 1e-12)
    logits = logit_scale * image_features @ text_features.t()
    return logits

