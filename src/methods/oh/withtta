def test_time_tuning(model, inputs, optimizer, cfg, target_output,current_aux):
    target_output = target_output.cuda()
    target_output =  nn.Softmax(dim=1)(target_output)
    
    # You may need to define TTA.STEPS in your config, defaulting to 1 here
    tta_steps = cfg.TTA.STEPS if hasattr(cfg, 'TTA') and hasattr(cfg.TTA, 'STEPS') else 1

    for j in range(tta_steps):
        with torch.amp.autocast('cuda'):
            output_logits,_ = model(inputs)             
            output = nn.Softmax(dim=1)(output_logits)
            # total_aux_loss = IID_losses.IID_loss(
            #     cfg.class_num,
            #     softmax_out,
            #     tta_clip_all_output, # <--- 修改点在这里！使用 TTA 精炼后的输出
            #     1-current_aux,
